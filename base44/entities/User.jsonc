{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "quiz_stats": {
      "type": "object",
      "title": "Quiz Gamification Stats",
      "properties": {
        "quiz_correct_total": {
          "type": "number",
          "title": "Total Correct Pop Quizzes"
        },
        "quiz_current_streak": {
          "type": "number",
          "title": "Current Streak"
        },
        "quiz_best_streak": {
          "type": "number",
          "title": "Best Streak"
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Earned Badges"
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}