{
  "name": "LearningModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "content": {
      "type": "string",
      "title": "Content (Markdown)"
    },
    "segment": {
      "type": "string",
      "enum": [
        "power_up",
        "storytelling"
      ],
      "title": "Segment"
    },
    "category": {
      "type": "string",
      "enum": [
        "Reading Confidence",
        "Reading Strategies",
        "Volunteer Skills",
        "Assessment Guide"
      ],
      "title": "Category"
    },
    "order": {
      "type": "number",
      "title": "Order"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (Minutes)"
    },
    "checkpoints": {
      "type": "array",
      "title": "Check-in Points",
      "items": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Scenario Prompt"
          },
          "model_answer": {
            "type": "string",
            "title": "Recommended Approach"
          }
        },
        "required": [
          "prompt",
          "model_answer"
        ]
      }
    },
    "practice_prompt": {
      "type": "string",
      "title": "AI Practice Prompt"
    },
    "coming_soon": {
      "type": "boolean",
      "title": "Coming Soon",
      "default": false
    }
  },
  "required": [
    "title",
    "description",
    "content",
    "segment",
    "order"
  ]
}